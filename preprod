#user  nobody;
worker_processes  1;

#error_log  logs/error.log;
#error_log  logs/error.log  notice;
#error_log  logs/error.log  info;

#pid        logs/nginx.pid;


events {
    worker_connections  1024;
}


http {
    include       mime.types;
    default_type  application/octet-stream;
	#more_clear_headers Server;
    server_tokens off;
    etag off;
    
 
    
    add_header Strict-Transport-Security "max-age=31536000; includeSubdomains; preload" always;
    add_header X-Frame-Options SAMEORIGIN  always;
    add_header X-Content-Type-Options nosniff always;
    add_header Access-Control-Allow-Credentials "" always;
	#more_set_headers "X-Powered-By: ";
	#more_set_headers "ETag: ";
    add_header ETag "";
    add_header Content-Security-Policy "default-src 'self' *.hdfclife.com blob:; img-src 'self' *.hdfclife.com data:; media-src 'self' *.hdfclife.com; script-src 'self' *.hdfclife.com 'unsafe-eval' 'unsafe-inline' blob:; style-src 'self' *.hdfclife.com *.googleapis.com 'unsafe-inline'; worker-src 'self' blob:; font-src 'self' *.hdfclife.com fonts.gstatic.com; frame-src 'self' data: blob:;" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Access-Control-Allow-Origin "https://partnerpp.hdfclife.com" always;
    																		   

																			  
																  
																	

 
    log_format  main  '$remote_addr - $remote_user [$time_local] $http_x_forwarded_proto "$request" '
                     '$status $body_bytes_sent "$http_referer" '
                     '"$http_user_agent" "$http_x_amzn_trace_id" "$cookie_SESSION" "$http_x_forwarded_for"';

    #log_format  main  '$remote_addr - $remote_user [$time_local] "$request" '
    #                  '$status $body_bytes_sent "$http_referer" '
    #                  '"$http_user_agent" "$http_x_forwarded_for"';

    #access_log  logs/access.log  main;

    sendfile        on;
    #tcp_nopush     on;

    #keepalive_timeout  0;
    keepalive_timeout  65;
    
	# This added to handle request tebt timeouts
    #proxy_read_timeout 180;
    #proxy_send_timeout 180;
    #send_timeout 180;
    #client_body_timeout 180;
    #lingering_timeout 180;
    proxy_read_timeout 900;
    proxy_send_timeout 900;
    send_timeout 100;
    client_body_timeout 100;
    lingering_timeout 100;
 
    real_ip_header    X-Forwarded-For;
    set_real_ip_from 0.0.0.0/0;
 
    client_max_body_size       5m;
    #gzip  on;

	map $sent_http_content_type $expires {
    	default                    off;
    	text/html                  epoch;
    	text/css                   max;
    	application/javascript     max;
    	~image/                    max;
    }
 
   upstream qlikcluster {
                #server hlqvapp2.hdfcsldm.com:443;
                server ec2amaz-e4nhvic.hdfcsldm.com:443;
  }	   
 
    server {
        listen       8080;
        server_name "";
    expires $expires;
			access_log  logs/access.log  main;
                error_page   500 502 503 504 403 404  /ErrorDocument/error_ip.html;
                if ( $http_user_agent ~ 'ELB-HealthChecker' ) {
                        return 200 Success;
                }
		if ($request_method ~ ^(OPTIONS)$ ){
			return 403;
		}
                location /ErrorDocument {
                        root .;
                        allow all;
                }
		location /auth {
			allow all;
                	proxy_set_header Host $host;
                	proxy_set_header X-Real-IP $remote_addr;
                	proxy_set_header   X-Forwarded-Proto $http_x_forwarded_proto;
                	proxy_pass http://localhost:8089;
        	}
 
        	location /apigateway {
			allow all;
                	proxy_set_header Host $host;
                	proxy_set_header X-Real-IP $remote_addr;
                	proxy_set_header   X-Forwarded-Proto $http_x_forwarded_proto;
                	proxy_pass http://localhost:8089;
        	}
             
           location /wow {
			allow all;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header   X-Forwarded-Proto $http_x_forwarded_proto;
            proxy_pass http://localhost:8089;
        }

        	location /cloudapigateway {
			allow all;
                	proxy_set_header Host $host;
                	proxy_set_header X-Real-IP $remote_addr;
                	proxy_set_header   X-Forwarded-Proto $http_x_forwarded_proto;
                	proxy_pass http://localhost:8089;
		}
                deny all ;
        }
	map $http_upgrade $connection_upgrade {
		default upgrade;
		'' close;
	}
 
