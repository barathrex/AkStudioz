                listen       8080;
                server_name "";
		expires $expires;
                access_log  logs/access.log  main;
                error_page   500 502 503 504 403 404 405 /ErrorDocument/error_ip.html;
		if ($request_method ~ ^(OPTIONS)$ ){
                        return 403;
        }
        if ( $http_user_agent ~ 'ELB-HealthChecker' ) {
                        return 200 Success;
        }
         location /ErrorDocument {
                       root .;
                       allow all;
        }
		location /kibana  {
			allow all;
			return 301 /_plugin/kibana/app/kibana#/discover?_g=(filters:!(),refreshInterval:(pause:!t,value:0),time:(from:now-15m,to:now))&_a=(columns:!(sessionid,userid,level,logmessage,module,fields.hostip),filters:!(),index:'921bae60-1393-11eb-8efa-d3332f5a05c5',interval:auto,query:(language:kuery,query:''),sort:!()) ;
		}
		location /_plugin/kibana {
			allow all;
			resolver 172.27.32.2;
        	# Forward requests to Kibana
        	proxy_pass https://$kibana_host;

        	# Handle redirects to Cognito
			#proxy_redirect https://$kibana_host/_plugin/kibana http://$host:8080;
        	#proxy_redirect https://$cognito_host https://$host;

        	# Update cookie domain and path
        		proxy_cookie_domain $kibana_host $host;
        		proxy_cookie_path / /_plugin/kibana/;

        	# Response buffer settings
       	 		proxy_buffer_size 128k;
        		proxy_buffers 4 256k;
        		proxy_busy_buffers_size 256k;
    		}
            #deny all ;
			allow all ;
        }	

		map $http_upgrade $connection_upgrade {
		default upgrade;
		'' close;
	}
		 
